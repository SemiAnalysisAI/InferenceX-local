+class SpbmCounters:
+    """A DGX Spark's SPBM energy counters as watts averaged between two polls.
+
+    The ``spbm`` hwmon driver (https://github.com/antheas/spark_hwmon) exposes them. Its
+    power channels are instantaneous and swing with the firmware's 100 ms control loop, so
+    an average needs the counters.
+    """
+
+    def __init__(self, hwmon_root: Path = Path("/sys/class/hwmon")) -> None:
+        hwmon = next((d for d in sorted(hwmon_root.glob("hwmon*")) if has_name(d, SPBM_HWMON_NAME)), None)
+        if hwmon is None:
+            raise SourceUnavailable(f"no {SPBM_HWMON_NAME} hwmon device found")
+        by_label = {
+            label: path.with_name(path.name.removesuffix("_label") + "_input")
+            for path in sorted(hwmon.glob("energy*_label"))
+            if (label := _read_text(path)) is not None
+        }
+        wanted = [label for labels in SPBM_COUNTERS.values() for label in labels]
+        missing = [label for label in wanted if label not in by_label]
+        if missing:
+            raise SourceUnavailable(f"{hwmon} has no energy counter labelled {', '.join(missing)}")
+        self._paths = {label: by_label[label] for label in wanted}
+        self._baseline: tuple[float, dict[str, int]] | None = None
+        self._watts: dict[str, float] = {}
+
+    def poll(self, now: float) -> None:
+        """Read every counter and publish each kind's average power since the previous read.
+
+        A poll that cannot read every counter publishes nothing, and neither does the poll after
+        it, which only takes a new baseline.
+        """
+        energies = self._read()
+        watts: dict[str, float] = {}
+        if energies is not None and self._baseline is not None:
+            then, before = self._baseline
+            watts = {
+                kind: sum((energies[label] - before[label]) % SPBM_COUNTER_RANGE_UJ for label in labels)
+                / 1_000_000.0
+                / (now - then)
+                for kind, labels in SPBM_COUNTERS.items()
+            }
+        self._baseline = None if energies is None else (now, energies)
+        self._watts = watts
+
+    def _read(self) -> dict[str, int] | None:
+        energies: dict[str, int] = {}
+        for label, path in self._paths.items():
+            try:
+                energies[label] = int(path.read_text())
+            except (OSError, ValueError):
+                return None
+        return energies
+
+    def render(self) -> str:
+        lines = [
+            "# HELP cpu_power_spbm_watts DGX Spark power averaged from SPBM energy counters (W).",
+            "# TYPE cpu_power_spbm_watts gauge",
+        ]
+        for kind, watts in self._watts.items():
+            lines.append(f'cpu_power_spbm_watts{{type="{kind}",socket="0",source="spbm"}} {watts:.6f}')
+        lines.append("")
+        return "\n".join(lines)
+
+
+def _open_acpi() -> Callable[[], str]:
+    sensors = _find_power_meter_sensors()
+    if not sensors:
+        raise SourceUnavailable("no ACPI power_meter hwmon sensors found")
+    print(f"Found {len(sensors)} sensor(s):", file=sys.stderr)
+    for s in sensors:
+        print(f"  [{s['type']}] socket={s['socket']}  {s['oem']}  ({s['path']})", file=sys.stderr)
+    return lambda: _build_metrics(sensors)
+
+
+def _open_spbm() -> Callable[[], str]:
+    counters = SpbmCounters()
+    counters.poll(time.monotonic())
+    time.sleep(SPBM_PRIME_SECONDS)
+    counters.poll(time.monotonic())
+
+    def poll_forever() -> None:
+        while True:
+            time.sleep(SPBM_POLL_SECONDS)
+            counters.poll(time.monotonic())
+
+    threading.Thread(target=poll_forever, daemon=True).start()
+    return counters.render
+
+
+# Each opener returns the function that renders a ``/metrics`` body, or raises SourceUnavailable.
+SOURCES: dict[str, Callable[[], Callable[[], str]]] = {"acpi": _open_acpi, "spbm": _open_spbm}
