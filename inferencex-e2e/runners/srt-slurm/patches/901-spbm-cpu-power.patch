+def _make_spbm(root: Path, **microjoules: int) -> Path:
+    """An ``spbm`` hwmon node with one energy counter per label, beside an unrelated node."""
+    (root / "hwmon0").mkdir()
+    (root / "hwmon0" / "name").write_text("acpitz\n")
+    hwmon = root / "hwmon6"
+    hwmon.mkdir()
+    (hwmon / "name").write_text("spbm\n")
+    for index, (label, value) in enumerate(microjoules.items(), start=1):
+        (hwmon / f"energy{index}_label").write_text(f"{label}\n")
+        (hwmon / f"energy{index}_input").write_text(f"{value}\n")
+    return hwmon
+
+
+def _set_spbm(hwmon: Path, **microjoules: int) -> None:
+    for label_path in hwmon.glob("energy*_label"):
+        label = label_path.read_text().strip()
+        if label in microjoules:
+            label_path.with_name(label_path.name.replace("_label", "_input")).write_text(f"{microjoules[label]}\n")
+
